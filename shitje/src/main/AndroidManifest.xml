<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="THA'NA Shitje" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Linku personal mund të hapet direkt me aplikacionin («Hap me THA'NA Shitje»). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="thana-shitje.vercel.app" />
            </intent-filter>
        </activity>
        <receiver android:name=".PlanPanelReceiver" android:exported="true" android:label="Ecuria e planit">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_p_plan" />
        </receiver>
        <receiver android:name=".TeamPanelReceiver" android:exported="true" android:label="Ekipi">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_p_team" />
        </receiver>
        <receiver android:name=".StockNegPanelReceiver" android:exported="true" android:label="Stoku negativ">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_p_stockneg" />
        </receiver>
        <receiver android:name=".CollectPanelReceiver" android:exported="true" android:label="Arkëtimet">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_p_collect" />
        </receiver>
        <receiver android:name=".TasksPanelReceiver" android:exported="true" android:label="Detyrat">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_p_tasks" />
        </receiver>
        <receiver android:name=".ReportsPanelReceiver" android:exported="true" android:label="Raportet">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_p_reports" />
        </receiver>
        <receiver android:name=".ProductPanelReceiver" android:exported="true" android:label="Ecuria e produktit">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_p_product" />
        </receiver>
        <receiver android:name=".ChatPanelReceiver" android:exported="true" android:label="Chat">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_p_chat" />
        </receiver>
        <receiver android:name=".StockPanelReceiver" android:exported="true" android:label="Gjendja e magazinës">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_p_stock" />
        </receiver>
        <receiver android:name=".RoutePanelReceiver" android:exported="true" android:label="Rruga e sotme">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_p_route" />
        </receiver>
        <receiver android:name=".DailyPanelReceiver" android:exported="true" android:label="Ditë pas dite">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_p_daily" />
        </receiver>
        <receiver android:name=".DistPanelReceiver" android:exported="true" android:label="Magazina ime (distributori)">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_p_dist" />
        </receiver>
    </application>
</manifest>
